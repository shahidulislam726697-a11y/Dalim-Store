# Database URL for PostgreSQL (e.g. Neon, Supabase, Cloud SQL, or local)
# If empty, Dalim Store POS automatically uses its built-in persistent storage engine
DATABASE_URL=""

# Secret key for JWT session authentication (32+ characters)
AUTH_SECRET="dalim_store_super_secret_auth_jwt_key_2026_xyz123"

# Vercel Blob read/write token for cloud image uploads (optional; direct image URLs also supported)
BLOB_READ_WRITE_TOKEN=""

# Store branding & currency
NEXT_PUBLIC_APP_NAME="Dalim Store"
NEXT_PUBLIC_CURRENCY="৳"
TZ="Asia/Dhaka"
